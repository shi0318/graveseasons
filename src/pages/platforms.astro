---
import SourcePanel from '../components/SourcePanel.astro';
import Layout from '../layouts/Layout.astro';
import { ASSETS } from '../data/assets';
import { SOURCES } from '../data/sources';
import { SITE } from '../data/site';

const title = 'Grave Seasons Platforms - PC, PS5, Xbox, Switch & Game Pass';
const description =
  'Grave Seasons is confirmed for PC, PS5, Xbox Series X|S and Nintendo Switch, with Day 1 Xbox Game Pass. Official store links and what is unannounced.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Platforms', url: '/platforms/' },
];
const sources = [SOURCES.steamDevlog, SOURCES.steam, SOURCES.blumhouse, SOURCES.playstation, SOURCES.xbox];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs} image={ASSETS.steamHeader.src}>
  <article class="mx-auto max-w-4xl">
    <p class="section-kicker">Platform tracker</p>
    <h1 class="mt-3 text-4xl font-black leading-tight text-bone md:text-5xl">
      Grave Seasons Platforms
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-fog">
      Perfect Garbage's official Steam announcement names four platforms - <strong>PC, Xbox Series X|S, PlayStation 5, and Nintendo Switch</strong> - and confirms Grave Seasons arrives on <strong>Xbox Game Pass on day one</strong>. This page tracks that announcement plus the live store listings, and still refuses to guess at editions, pricing, preload timing, or performance modes.
    </p>

    <section class="mt-8 grid gap-4 md:grid-cols-3">
      <a href={SITE.steamUrl} target="_blank" rel="nofollow noopener noreferrer" class="surface p-5">
        <p class="text-xs font-black uppercase text-wheat">PC listing</p>
        <h2 class="mt-2 text-xl font-black text-bone">Steam</h2>
        <p class="mt-2 text-sm text-fog">Steam page is live for app {SITE.appId}; Steam currently lists the release timing as {SITE.steamReleaseText}.</p>
      </a>
      <a href={SITE.playstationUrl} target="_blank" rel="nofollow noopener noreferrer" class="surface p-5">
        <p class="text-xs font-black uppercase text-wheat">Console listing</p>
        <h2 class="mt-2 text-xl font-black text-bone">PlayStation</h2>
        <p class="mt-2 text-sm text-fog">A PlayStation Store concept page is live and linked from the official platform ecosystem.</p>
      </a>
      <a href={SITE.xboxUrl} target="_blank" rel="nofollow noopener noreferrer" class="surface p-5">
        <p class="text-xs font-black uppercase text-wheat">Console listing</p>
        <h2 class="mt-2 text-xl font-black text-bone">Xbox / Microsoft Store</h2>
        <p class="mt-2 text-sm text-fog">A Microsoft Store product page is live, and the studio has confirmed Grave Seasons joins Xbox Game Pass on day one.</p>
      </a>
    </section>

    <section class="prose-page mt-10">
      <h2>Official platform baseline</h2>
      <p>
        Two first-party Steam posts do the work here. The <strong>26 March 2026</strong> announcement stated that "Grave Seasons will launch on August 14, 2026 for PC, Xbox Series X|S, PlayStation 5, and Nintendo Switch," and added that it "will also be released on Day 1 for Xbox Game Pass players." The follow-up on <strong>5 June 2026</strong> then moved the launch to <strong>Fall 2026</strong> - explicitly "across all announced platforms," so the four-platform list and the Game Pass commitment still stand. Steam's storefront text currently just reads 2026.
      </p>
      <p>
        What that leaves unanswered is everything commercial: no price, no editions, no preload window, no per-platform performance modes, and no Switch store listing yet even though the platform is confirmed. Searches for "Grave Seasons PS5", "Grave Seasons Switch", and "Grave Seasons Game Pass" now have real answers; the store details do not.
      </p>
    </section>

    <section class="mt-10">
      <p class="section-kicker">Comparison table</p>
      <h2 class="mt-2 text-2xl font-black text-bone">What each official listing supports</h2>
      <div class="mt-5 overflow-x-auto rounded-md border border-white/10">
        <table class="w-full min-w-[760px] border-collapse text-sm">
          <thead class="bg-moss/25 text-left text-bone">
            <tr>
              <th class="px-4 py-3">Platform query</th>
              <th class="px-4 py-3">Verified source</th>
              <th class="px-4 py-3">Safe wording</th>
            </tr>
          </thead>
          <tbody class="text-fog">
            <tr class="border-t border-white/10">
              <td class="px-4 py-3 font-bold text-bone">Grave Seasons PC</td>
              <td class="px-4 py-3">Steam store page + official announcement</td>
              <td class="px-4 py-3">Confirmed platform. Steam listing is live; storefront text currently shows 2026.</td>
            </tr>
            <tr class="border-t border-white/10">
              <td class="px-4 py-3 font-bold text-bone">Grave Seasons PlayStation 5</td>
              <td class="px-4 py-3">Official announcement + PlayStation Store concept page</td>
              <td class="px-4 py-3">Confirmed for PS5 by name. Store page is live; no price or edition data yet.</td>
            </tr>
            <tr class="border-t border-white/10">
              <td class="px-4 py-3 font-bold text-bone">Grave Seasons Xbox Series X|S</td>
              <td class="px-4 py-3">Official announcement + Microsoft Store page</td>
              <td class="px-4 py-3">Confirmed for Series X|S. No Xbox One version has been announced.</td>
            </tr>
            <tr class="border-t border-white/10">
              <td class="px-4 py-3 font-bold text-bone">Grave Seasons Game Pass</td>
              <td class="px-4 py-3">Official announcement (26 March 2026)</td>
              <td class="px-4 py-3">Confirmed: released on Xbox Game Pass on day one. Which tiers is not stated.</td>
            </tr>
            <tr class="border-t border-white/10">
              <td class="px-4 py-3 font-bold text-bone">Grave Seasons Switch</td>
              <td class="px-4 py-3">Official announcement (26 March 2026)</td>
              <td class="px-4 py-3">Confirmed for Nintendo Switch. No eShop listing is tracked yet, and Switch 2 has not been mentioned.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="prose-page mt-10">
      <h2>Update rules for launch</h2>
      <p>
        When more store data appears, this page should add pricing, editions, preload dates, achievements or trophies, accessibility notes, controller support, and platform-specific screenshots only after those details can be verified. If a platform holder changes a listing before Blumhouse updates the main page, keep both source dates visible so readers can see which information changed first.
      </p>
    </section>

    <SourcePanel sources={sources} />
  </article>
</Layout>
