---
import SourcePanel from '../components/SourcePanel.astro';
import Layout from '../layouts/Layout.astro';
import { ASSETS } from '../data/assets';
import { CORE_SOURCES } from '../data/sources';
import { SITE } from '../data/site';

const title = 'About Grave Seasons Guide';
const description =
  'About Grave Seasons Guide, an independent official-source fan guide for romance, walkthrough, characters, quests, and launch updates.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs} image={ASSETS.steamHeader.src}>
  <article class="mx-auto max-w-3xl">
    <p class="section-kicker">Trust page</p>
    <h1 class="mt-3 text-4xl font-black leading-tight text-bone md:text-5xl">
      About {SITE.name}
    </h1>
    <div class="prose-page mt-6">
      <p>
        {SITE.name} is an independent fan guide for Grave Seasons. Its job is to help players find romance, walkthrough, character, quest, and tips information without mixing official facts with guesswork.
      </p>
      <h2>Editorial rules</h2>
      <ul>
        <li>Official-source facts are labeled and linked.</li>
        <li>Unreleased route details are marked as unconfirmed or launch-tracking.</li>
        <li>Release dates use current Steam and Blumhouse wording, not outdated planning dates.</li>
        <li>Launch guides will include game version and spoiler warnings where needed.</li>
      </ul>
      <h2>How pages are researched</h2>
      <p>
        Grave Seasons is not released until March 9, 2027, so every page is built from first-party material: the Steam store page for App 3255110, the developer's announcements and devlogs on the Steam news hub, the official Blumhouse Games page and media gallery, and the PlayStation and Microsoft store listings. Source panels date the material they cover; some planning articles summarize the confirmed premise without a separate source panel. When an official post changes a fact, such as the move from a Fall 2026 window to March 9, 2027, the affected pages are rewritten and the change is described with its date rather than silently replaced.
      </p>
      <p>
        Where a page gives advice, such as the <a href="/grave-seasons-prelaunch-one-year-planner/">one-year planner</a> or the <a href="/killer-decisions-and-replay/">investigation notes guide</a>, it is labeled as planning guidance. Crop values, gift preferences, killer identities, and quest steps will only be added once they can be checked in the released game.
      </p>
      <h2>Corrections</h2>
      <p>
        If something on the site is wrong or out of date, email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> with the page and a link to the official source. When a correction is confirmed, we update every page that repeats the fact.
      </p>
      <h2>Independence</h2>
      <p>
        This site is not affiliated with or endorsed by Perfect Garbage or Blumhouse Games. It uses official public pages for factual references and links users back to official stores. See the <a href="/terms/">Terms of Use</a> and <a href="/privacy-policy/">Privacy Policy</a> for how the site operates.
      </p>
    </div>
    <SourcePanel sources={CORE_SOURCES} />
  </article>
</Layout>
