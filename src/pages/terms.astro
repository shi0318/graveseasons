---
import Layout from '../layouts/Layout.astro';
import { ASSETS } from '../data/assets';
import { SITE } from '../data/site';

const title = 'Terms of Use - Grave Seasons Guide';
const description =
  'Terms of Use for Grave Seasons Guide, an unofficial fan guide not affiliated with Perfect Garbage or Blumhouse Games.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Terms of Use', url: '/terms/' },
];
const effectiveDate = 'November 9, 2026';
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs} image={ASSETS.steamHeader.src}>
  <article class="prose-page mx-auto max-w-3xl">
    <p class="section-kicker">Site policy</p>
    <h1 class="mt-3 text-4xl font-black leading-tight text-bone md:text-5xl">Terms of Use</h1>
    <p>Effective date: {effectiveDate}</p>
    <p>
      These terms apply to your use of {SITE.name} ({SITE.url.replace('https://', '')}). By reading or using the site, you
      agree to them. If you do not agree, please do not use the site.
    </p>

    <h2>An unofficial fan guide</h2>
    <p>
      {SITE.name} is an independent, unofficial fan guide for the video game Grave Seasons. It is not affiliated with,
      endorsed by, sponsored by, or approved by {SITE.developer}, {SITE.publisher}, Valve, Sony Interactive Entertainment,
      Microsoft, Nintendo, or any other company connected to the game or its storefronts. Nothing on this site is an
      official statement from any of them.
    </p>

    <h2>Content is provided as is</h2>
    <p>
      We write each page from official sources where possible and say where information comes from, but the content is
      provided "as is" and "as available", without warranties of any kind, express or implied, including accuracy,
      completeness, or fitness for a particular purpose. Use the guides at your own discretion. To the fullest extent
      permitted by law, we are not liable for any loss or damage arising from your use of the site or reliance on its
      content.
    </p>

    <h2>Pre-release information may change</h2>
    <p>
      Grave Seasons has not been released. Release dates, platforms, prices, features, and other pre-release details on
      this site reflect official information at the time we checked it and may change without notice; the release date
      has already moved several times. Always confirm purchase decisions on the official store pages. Gameplay guidance
      written before launch is planning advice, not tested in-game instruction.
    </p>

    <h2>Trademarks and copyright</h2>
    <p>
      Grave Seasons, its logos, characters, screenshots, artwork, and related marks are the property of their respective
      owners. They are used here only to identify the game and to illustrate commentary about it. The site's own
      original text may not be republished in bulk without permission; short quotations with a link back are welcome.
      If you are a rights holder and believe material here should be removed or credited differently, contact us using
      the address below and we will review it promptly.
    </p>

    <h2>Advertising and third-party links</h2>
    <p>
      The site may display advertisements served by third parties such as Google AdSense, and it links to external
      websites including Steam, Blumhouse, PlayStation, and Microsoft. We do not control and are not responsible for the
      content, products, or privacy practices of advertisers or linked sites. An advertisement is not an endorsement. How
      advertising and analytics cookies work, and how to opt out, is explained in our
      <a href="/privacy-policy/">Privacy Policy</a>.
    </p>

    <h2>No game files or downloads</h2>
    <p>
      This site does not host, sell, or distribute game files, installers, keys, or demos. Any download offered in our
      name is not from us.
    </p>

    <h2>Changes to these terms</h2>
    <p>
      We may update these terms from time to time. The effective date above shows when they were last changed, and
      continued use of the site after a change means you accept the updated terms.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about these terms can be sent to <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
    </p>
  </article>
</Layout>
