---
import { NAV, SITE } from '../data/site';
import { CORE_SOURCES } from '../data/sources';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-soil">
  <div class="container py-12">
    <div class="grid gap-8 md:grid-cols-[1.25fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-md border border-wheat/30 bg-wheat/10 text-sm font-black text-wheat">
            GS
          </span>
          <div>
            <p class="text-sm font-black uppercase text-bone">{SITE.name}</p>
            <p class="text-xs font-semibold uppercase text-fog">{SITE.tagline}</p>
          </div>
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-fog">
          Independent fan guide for Grave Seasons. We publish confirmed facts from official sources first, then update walkthrough and romance routes after release.
        </p>
      </div>

      <nav aria-label="Guide links">
        <p class="text-xs font-black uppercase text-bone">Guides</p>
        <ul class="mt-3 space-y-2">
          {NAV.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-fog hover:text-wheat">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Official links">
        <p class="text-xs font-black uppercase text-bone">Official sources</p>
        <ul class="mt-3 space-y-2">
          {CORE_SOURCES.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="nofollow noopener noreferrer" class="text-sm text-fog hover:text-wheat">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-xs leading-relaxed text-fog">
      <p>
        This site is not affiliated with or endorsed by {SITE.developer} or {SITE.publisher}. Grave Seasons, screenshots, names, and trademarks belong to their respective owners.
      </p>
      <p class="mt-2">
        Pages are last verified against official sources on {SITE.lastVerified}. Contact:
        <a href={`mailto:${SITE.contactEmail}`} class="text-wheat underline underline-offset-2">{SITE.contactEmail}</a>.
      </p>
      <p class="mt-2">&copy; {year} {SITE.name}.</p>
    </div>
  </div>
</footer>
