---
import { NAV, SITE } from '../data/site';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/82 backdrop-blur-xl">
  <nav class="container flex items-center justify-between gap-4 py-3" aria-label="Primary navigation">
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label={`${SITE.name} home`}>
      <span class="grid h-10 w-10 place-items-center rounded-md border border-wheat/30 bg-wheat/10 text-sm font-black text-wheat">
        GS
      </span>
      <span class="min-w-0">
        <span class="block truncate text-sm font-black uppercase text-bone">Grave Seasons</span>
        <span class="block truncate text-xs font-semibold uppercase text-fog">Guide & source tracker</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-semibold transition-colors',
                isActive(item.href)
                  ? 'bg-wheat/12 text-wheat'
                  : 'text-fog hover:bg-white/5 hover:text-bone',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-white/15 px-3 py-2 text-sm font-bold text-bone">
        Menu
      </summary>
      <ul class="absolute right-0 mt-2 w-56 rounded-md border border-white/12 bg-soil p-2 shadow-2xl">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-md px-3 py-2.5 text-sm font-semibold',
                  isActive(item.href)
                    ? 'bg-wheat/12 text-wheat'
                    : 'text-fog hover:bg-white/5 hover:text-bone',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
